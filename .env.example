# --- LiveKit (rooms, agent dispatch, outbound SIP) -----------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk created in LiveKit (lk sip outbound create …). Required for live calls.
SIP_TRUNK_ID=

# --- Models ---------------------------------------------------------------------------
GEMINI_API_KEY=            # conversation LLM, post-call grader, role composer
ELEVENLABS_API_KEY=        # default voice (TTS=eleven)
SMALLEST_API_KEY=          # default speech recognition (STT=smallest)
# SARVAM_API_KEY=          # only for STT=sarvam or TTS=sarvam

# --- Optional overrides ---------------------------------------------------------------
# LLM_MODEL=gemini-3.5-flash-lite
# RECORD_LLM=gemini-2.5-flash
# TTS=eleven               # eleven | gemini | sarvam
# STT=smallest             # smallest | sarvam
# AGENT_NAME=openfury      # the worker's LiveKit agent name; the API dispatches to it
# LIVEKIT_CLOUD=1          # auto from LIVEKIT_URL; 0 on self-hosted LiveKit (no noise cancellation, local turn model)
# DATA_DIR=data            # calls, recordings, platform.db, tenants.json
# PUBLIC_BASE_URL=https://calls.example.com   # used in recording links and /apidoc
# DEFAULT_COUNTRY_CODE=91
# DEFAULT_TIMEZONE=Asia/Kolkata
# MAX_CONCURRENT_CALLS=10
